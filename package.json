{
  "name": "timeline-war",
  "private": true,
  "version": "1.0.0",
  "description": "Timeline War — a tiny 1-lane RTS where you evolve from club-wielding cavemen to modern snipers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garouthehumanmonster/git_test.git"
  },
  "homepage": "https://github.com/garouthehumanmonster/git_test#readme",
  "keywords": [
    "rts",
    "phaser",
    "webgl",
    "pixel-art",
    "deterministic",
    "simulation"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python scripts/e2e-browser-check.py",
    "sim": "tsx scripts/sim-match.ts",
    "sim:baseline": "tsx scripts/sim-baseline.ts",
    "typecheck": "tsc --noEmit",
    "art:build": "tsx scripts/build-backdrops.ts",
    "art:preview": "tsx scripts/render-preview.ts"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
